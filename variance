"""
variance.py

This script provides functionality to compute the variance of heterozygosity for different fragmentation types
from simulation results. It processes a dictionary of results and returns a concatenated DataFrame containing
the variance per replica and step for each specified fragmentation type.

Functions:
    process_variance(data, fragmentation_types): 
        Prepares concatenated per-replica variance data for given fragmentation types.

Dependencies:
    - pandas as pd
    - The following must be defined/imported elsewhere:
        - Dict, List (from typing)
        - FragmentationResult
        - variance_per_replica_step (function)
"""

from typing import Dict, List
import pandas as pd

def process_variance(
    data: Dict[str, FragmentationResult],
    fragmentation_types: List[str]
) -> pd.DataFrame:
    """
    Prepare concatenated per-replica variance data.

    :param data: Dict of frag_type → FragmentationResult.
    :param fragmentation_types: List of frag_types to process.
    :return: DataFrame with columns ['fragmentation_type', 'replica', 'step', 'variance'].
    """
    dfs = []
    for frag_type in fragmentation_types:
        var_df = variance_per_replica_step(data, frag_type)
        var_df['frag_type'] = frag_type
        dfs.append(var_df)
    return pd.concat(dfs, ignore_index=True)

