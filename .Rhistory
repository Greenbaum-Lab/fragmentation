theme_minimal() +  # Using a clean theme
labs(
x = "Time step"
)
# Calculate a scaling factor, if necessary
scaling_factor <- max(merged_cor$returnrate_mean, na.rm = TRUE) / max(merged_cor$het_mean, na.rm = TRUE)
# Plot for SK measure
