geom_line(aes(y = returnrate_mean), color = "blue") +
geom_ribbon(aes(ymin = returnrate_ci_lower, ymax = returnrate_ci_upper), fill = "blue", alpha = 0.2) +
scale_y_continuous(
name = "rr",
sec.axis = sec_axis(~ . * scaling_factor/10, name = "Heterozygosity")
)
# Add the HET measure, applying the inverse of the scaling factor
het_plot <- sd_plot +
geom_line(aes(y = het_mean * scaling_factor), color = "red") +
geom_ribbon(aes(ymin = het_ci_lower * scaling_factor, ymax = het_ci_upper * scaling_factor), fill = "red", alpha = 0.2)
# Finalize plot with appropriate labels
het_plot
