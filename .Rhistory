# make index 1-based and steps to timeindex colum
data_cor$step=data_cor$step+1
names(data_cor)[2]='timeindex'
summary_het <- function(final_df) {
summary_stats <- final_df %>%
group_by(timeindex) %>%
summarise(across(c(het),
.fns = list(
mean = ~mean(., na.rm = TRUE),
ci_lower = ~mean(., na.rm = TRUE) - qt(0.975, df = n() - 1) * (sd(., na.rm = TRUE) / sqrt(n())),
ci_upper = ~mean(., na.rm = TRUE) + qt(0.975, df = n() - 1) * (sd(., na.rm = TRUE) / sqrt(n()))
),
.names = "{.col}_{.fn}"))
return(summary_stats)
}
compute_summary_stats <- function(final_df) {
summary_stats <- final_df %>%
group_by(timeindex) %>%
summarise(across(c(ar1, sd, sk, kurt, cv, returnrate, densratio, acf1),
.fns = list(
mean = ~mean(., na.rm = TRUE),
ci_lower = ~mean(., na.rm = TRUE) - qt(0.975, df = n() - 1) * (sd(., na.rm = TRUE) / sqrt(n())),
ci_upper = ~mean(., na.rm = TRUE) + qt(0.975, df = n() - 1) * (sd(., na.rm = TRUE) / sqrt(n()))
),
.names = "{.col}_{.fn}"))
return(summary_stats)
}
