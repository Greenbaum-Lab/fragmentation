compute_ews <- function(data) {
# Determine the maximum number of replicas
n_reps <- max(data$replica)
# Initialize a list to hold the results from each replica and node_number
all_out <- list()
# Loop over each replica
for (rep in 1:n_reps) {
tryCatch({
# Subset data for the current replica
data_rep <- subset(data, replica == rep)
# Get unique node numbers within this replica
node_numbers <- unique(data_rep$node_number)
# List to store results for each node_number within the current replica
rep_out <- list()
# Loop over each node_number
for (node in node_numbers) {
# Subset data for the current node_number
data_sub <- subset(data_rep, node_number == node)
if (nrow(data_sub) > 0) {
# Select only the 'het' column
data_sub <- data_sub[, 'het', drop = FALSE]
# Calculate early warning signals
out <- generic_ews(data_sub, winsize = 50, logtransform = FALSE, interpolate = FALSE)
# Add replica and node_number to the output
out$replica <- rep
out$node_number <- node
# Append to the list of results for this replica
rep_out[[paste(rep, node, sep = "_")]] <- out
}
}
# Combine all results from this replica into the main list
all_out <- c(all_out, rep_out)
}, error = function(e) {
# Handle any errors during processing
cat("Error in processing replica", rep, ": ", e$message, "\n")
})
}
# Combine all results into a single dataframe
final_df <- do.call(rbind, all_out)
return(final_df)
}
compute_kendall <- function(data) {
tau_result <- MannKendall(data)
tau <- tau_result$tau
n <- length(data)
het_rank <- rank(data)
var_unadjusted <- 2 * (2 * n + 5) / (9 * n * (n - 1))
auto_corr <- acf(het_rank, lag.max = n-1, plot = FALSE)$acf
multiplier <- sum((n - (1:(n-1))) * (n - 1 - (1:(n-1))) * (n - 2 - (1:(n-1))) * auto_corr[-1])
correction_factor <- 2 * multiplier / (n * (n - 1) * (n - 2))
var_adjusted <- var_unadjusted * (1 + correction_factor)
SE_adjusted <- sqrt(var_adjusted)
Z <- tau / SE_adjusted
p_value <- 2 * (1 - pnorm(abs(Z)))
c(tau = tau, p_value = p_value)
}
kendall_loop <- function(df, measurements) {
# Initialize an empty list to store results
results <- list()
# Get unique combinations of replica and node_number
unique_combinations <- unique(df[, c("replica", "node_number")])
# Loop over each combination of replica and node_number
for (i in seq_len(nrow(unique_combinations))) {
# Filter data for the current replica and node_number
current_combination <- unique_combinations[i, ]
df_replica_node <- df %>%
filter(replica == current_combination$replica, node_number == current_combination$node_number)
# List to store results for each measurement of the current replica and node_number
replica_node_results <- list(replica = current_combination$replica, node_number = current_combination$node_number)
# Compute Kendall's tau for each measurement
for (measure in measurements) {
measure_data <- df_replica_node[[measure]]
kendall_results <- compute_kendall(measure_data)
replica_node_results[[paste(measure, "tau")]] <- kendall_results["tau"]
replica_node_results[[paste(measure, "p")]] <- kendall_results["p_value"]
}
# Append results for this replica and node_number
results[[length(results) + 1]] <- replica_node_results
}
# Combine all results into a dataframe
results_df <- do.call(rbind, lapply(results, as.data.frame))
return(results_df)
}
################# compute EWS
